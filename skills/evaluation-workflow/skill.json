{
  "schemaVersion": "1.0",
  "name": "evaluation-workflow",
  "description": "Run static benchmark evaluation and write evaluation-results.json.",
  "supportedPlatforms": ["linux", "darwin", "win32"],
  "supportedEnvironments": ["node"],
  "requiredInputs": [
    { "name": "projectDir", "description": "Generated project directory." },
    { "name": "resultsDir", "description": "Directory for evaluation results." }
  ],
  "optionalInputs": [
    { "name": "model", "description": "Model metadata." },
    { "name": "provider", "description": "Provider metadata." },
    { "name": "harness", "description": "Harness metadata.", "default": "opencode" },
    { "name": "level", "description": "Spec level metadata." },
    { "name": "backend", "description": "Backend framework.", "default": "spring-boot" },
    { "name": "frontend", "description": "Frontend framework.", "default": "angular" },
    { "name": "quiet", "description": "Suppress script detail output.", "default": false }
  ],
  "prechecks": [
    { "type": "command-available", "command": "node", "description": "Node.js is required for static evaluation." },
    { "type": "dir-exists", "path": "${projectDir}", "description": "Generated project directory must exist." },
    { "type": "file-exists", "path": "EVAL/comprehensive-evaluator.js", "description": "Comprehensive evaluator must exist." },
    { "type": "path-inside", "path": "${resultsDir}", "root": "RESULTS", "description": "Evaluation results must stay under RESULTS." }
  ],
  "execution": [
    {
      "name": "static evaluation",
      "command": [
        "node",
        "skills/evaluation-workflow/scripts/evaluate-static.js",
        "--project-dir",
        "${projectDir}",
        "--results-dir",
        "${resultsDir}",
        "--model",
        "${model}",
        "--provider",
        "${provider}",
        "--harness",
        "${harness}",
        "--level",
        "${level}",
        "--backend",
        "${backend}",
        "--frontend",
        "${frontend}"
      ],
      "optionalArgs": [
        { "input": "quiet", "args": ["--quiet"] }
      ]
    }
  ],
  "expectedOutputs": [
    { "description": "Static evaluation report.", "path": "${resultsDir}/evaluation-results.json", "required": true }
  ],
  "failureHandling": {
    "stopOnFailure": true,
    "diagnostics": [
      "Confirm the generated project has a recognizable application structure.",
      "Run node --check EVAL/comprehensive-evaluator.js if evaluation exits before producing JSON."
    ]
  },
  "recovery": {
    "instructions": [
      "Fix evaluator defects in EVAL/ or regenerate the project if the generated structure is invalid.",
      "Static evaluation does not mutate the generated workspace."
    ]
  },
  "validation": [
    { "type": "file-exists", "path": "${resultsDir}/evaluation-results.json", "description": "Static evaluation report was produced." }
  ]
}
