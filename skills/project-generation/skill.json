{
  "schemaVersion": "1.0",
  "name": "project-generation",
  "description": "Generate one benchmark project with prompt rendering, harness invocation, retries, timeout monitoring, and session tracking.",
  "supportedPlatforms": ["linux", "darwin", "win32"],
  "supportedEnvironments": ["node", "opencode|pi|claude|codex|mimo-code"],
  "requiredInputs": [
    { "name": "model", "description": "Model identifier passed to the generation harness." },
    { "name": "level", "description": "Specification level.", "allowedValues": ["overview", "detailed"] },
    { "name": "backend", "description": "Backend cartridge.", "allowedValues": ["node-js", "spring-boot", "quarkus"] },
    { "name": "frontend", "description": "Frontend cartridge.", "allowedValues": ["react", "angular"] }
  ],
  "optionalInputs": [
    { "name": "harness", "description": "Generation harness.", "default": "opencode" },
    { "name": "provider", "description": "Model provider namespace.", "default": "z-ai" },
    { "name": "outputDir", "description": "Output workspace directory.", "default": "WORKSPACE/${modelSlug}/${level}" },
    { "name": "timeout", "description": "Hard generation timeout in seconds.", "default": "600" },
    { "name": "inactivityTimeout", "description": "No-file-activity timeout in seconds." },
    { "name": "autoApprove", "description": "Allow harness permission auto-approval.", "default": "true" },
    { "name": "retries", "description": "Generation attempts before failing.", "default": "3" },
    { "name": "dryRun", "description": "Build command without invoking the remote harness.", "default": false }
  ],
  "prechecks": [
    { "type": "input-required", "name": "model", "description": "A model id is required." },
    { "type": "input-enum", "name": "level", "values": ["overview", "detailed"], "description": "The spec level must be supported." },
    { "type": "input-enum", "name": "backend", "values": ["node-js", "spring-boot", "quarkus"], "description": "The backend must be supported." },
    { "type": "input-enum", "name": "frontend", "values": ["react", "angular"], "description": "The frontend must be supported." },
    { "type": "input-enum", "name": "harness", "values": ["opencode", "pi", "claude", "codex", "kilo-code", "mimo-code"], "description": "The harness must be supported." },
    { "type": "input-enum", "name": "provider", "values": ["z-ai", "zai-coding-plan", "zai-coding-cn", "openrouter", "mimo", "openai", "anthropic"], "description": "The provider must be supported." },
    { "type": "env-set", "name": "OPENROUTER_API_KEY", "description": "OpenRouter credentials are required when provider is openrouter.", "whenInputEquals": { "name": "provider", "value": "openrouter" } },
    { "type": "command-available", "command": "node", "description": "Node.js is required for prompt rendering and evaluation metadata." },
    { "type": "file-exists", "path": "${template}", "description": "Prompt template must exist." },
    { "type": "file-exists", "path": "${specFile}", "description": "Specification file must exist." },
    { "type": "file-exists", "path": "${backendCartridge}", "description": "Backend cartridge must exist." },
    { "type": "file-exists", "path": "${frontendCartridge}", "description": "Frontend cartridge must exist." },
    { "type": "path-inside", "path": "${outputDir}", "root": "WORKSPACE", "description": "Generated project output must stay under WORKSPACE." }
  ],
  "execution": [
    {
      "name": "generate project",
      "command": [
        "node",
        "skills/project-generation/scripts/generate-project.js",
        "--model",
        "${model}",
        "--level",
        "${level}",
        "--backend",
        "${backend}",
        "--frontend",
        "${frontend}",
        "--output-dir",
        "${outputDir}",
        "--harness",
        "${harness}",
        "--provider",
        "${provider}",
        "--auto-approve",
        "${autoApprove}",
        "--retries",
        "${retries}",
        "--timeout",
        "${timeout}",
        "--dry-run",
        "${dryRun}"
      ],
      "optionalArgs": [
        { "input": "inactivityTimeout", "args": ["--inactivity-timeout", "${inactivityTimeout}"] }
      ]
    }
  ],
  "expectedOutputs": [
    { "description": "Generated project workspace.", "path": "${outputDir}", "required": true },
    { "description": "Harness session id file when supported.", "path": "${outputDir}/.${harness}-session-id", "required": false },
    { "description": "Harness session audit record.", "path": "${outputDir}/.${harness}-session", "required": false }
  ],
  "failureHandling": {
    "stopOnFailure": true,
    "diagnostics": [
      "Inspect the harness JSONL log under logs/harness.",
      "Inspect the per-harness session record in the workspace when one was produced.",
      "Generation stops if the harness exits non-zero, produces no files, times out, or becomes inactive."
    ]
  },
  "recovery": {
    "instructions": [
      "Rerun with a larger --timeout or --inactivity-timeout if file generation was still active.",
      "Rerun with the preserved session id to resume a recoverable harness session.",
      "Use --reset at the benchmark workflow level to remove partial workspace/results before retrying."
    ],
    "commands": [
      {
        "name": "cleanup partial workspace after failed reset run",
        "whenInputEquals": { "name": "reset", "value": true },
        "with": { "scope": "workspace" },
        "command": [
          "node",
          "skills/cleanup-benchmark/scripts/cleanup.js",
          "--model",
          "${model}",
          "--level",
          "${level}",
          "--backend",
          "${backend}",
          "--frontend",
          "${frontend}",
          "--harness",
          "${harness}",
          "--scope",
          "workspace",
          "--quiet"
        ]
      }
    ]
  },
  "validation": [
    { "type": "dir-exists", "path": "${outputDir}", "description": "Generated workspace directory exists.", "whenInputEquals": { "name": "dryRun", "value": false } }
  ]
}
