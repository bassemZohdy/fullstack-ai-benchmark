{
  "schemaVersion": "1.0",
  "name": "e2e-testing",
  "description": "Build, deploy, and runtime-test a generated project through the E2E runner.",
  "supportedPlatforms": ["linux", "darwin", "win32"],
  "supportedEnvironments": ["node", "docker"],
  "requiredInputs": [
    { "name": "projectDir", "description": "Generated project directory." },
    { "name": "backend", "description": "Backend framework.", "allowedValues": ["spring-boot", "node-js"] },
    { "name": "frontend", "description": "Frontend framework.", "allowedValues": ["react", "angular"] }
  ],
  "optionalInputs": [
    { "name": "e2eResultsFile", "description": "E2E JSON results file.", "default": "RESULTS/${modelSlug}/${backend}-${frontend}/${level}/e2e-execution.json" },
    { "name": "buildTimeout", "description": "Build timeout in milliseconds.", "default": "900000" },
    { "name": "composeTimeout", "description": "Docker compose startup timeout in milliseconds.", "default": "120000" },
    { "name": "healthTimeout", "description": "Readiness timeout in milliseconds.", "default": "120000" }
  ],
  "prechecks": [
    { "type": "command-available", "command": "node", "description": "Node.js is required for the E2E runner." },
    { "type": "command-available", "command": "docker", "description": "Docker is required for runtime validation." },
    { "type": "dir-exists", "path": "${projectDir}", "description": "Generated project directory must exist." },
    { "type": "runtime-supported", "description": "E2E is supported only for spring-boot/node-js with angular/react." },
    { "type": "path-inside", "path": "${e2eResultsFile}", "root": "RESULTS", "description": "E2E results file must stay under RESULTS." }
  ],
  "execution": [
    {
      "name": "runtime validation",
      "command": [
        "node",
        "skills/e2e-testing/scripts/run-e2e.js",
        "--project-dir",
        "${projectDir}",
        "--backend",
        "${backend}",
        "--frontend",
        "${frontend}",
        "--results-file",
        "${e2eResultsFile}",
        "--build-timeout",
        "${buildTimeout}",
        "--compose-timeout",
        "${composeTimeout}",
        "--health-timeout",
        "${healthTimeout}"
      ]
    }
  ],
  "expectedOutputs": [
    { "description": "E2E execution report.", "path": "${e2eResultsFile}", "required": true }
  ],
  "failureHandling": {
    "stopOnFailure": true,
    "diagnostics": [
      "Inspect Docker build and compose logs in the E2E output.",
      "Confirm generated API routes match the benchmark todo contract."
    ]
  },
  "recovery": {
    "instructions": [
      "Increase build, compose, or health timeout if the project is slow but progressing.",
      "Stop or remove any leftover containers from the generated compose project before retrying."
    ]
  },
  "validation": [
    { "type": "file-exists", "path": "${e2eResultsFile}", "description": "E2E results file was produced." }
  ]
}
